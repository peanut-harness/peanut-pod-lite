import assert from 'node:assert/strict';
import { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import test from 'node:test';
import { RuntimeFacade } from '@peanut/pod-engine/runtime';
import { EditorMcpActionRouter } from '../src/editor-mcp-action-router.js';

const png = Buffer.from('', 'base64');

for (const version of ['3.8.3','3.8.7']) {
    for (const operation of ['asset.importPlan','asset.import','mixed'] as const) {
        test(version + ' bounded FNT ' + operation + ' refuses before native or ledger writes', async () => {
            const root = mkdtempSync(join(tmpdir(), 'pod-fnt-refusal-')); mkdirSync(join(root,'assets')); mkdirSync(join(root,'temp/logs'),{recursive:true}); writeFileSync(join(root,'temp/logs/project.log'),''); writeFileSync(join(root,'package.json'), JSON.stringify({creator:{version}}));
            const font=join(root,'Bad.fnt'); const text='info face="Probe" size=16\ncommon pages=1 lineHeight=16 scaleW=512 scaleH=224\npage id=0 file="pages/Page.png"\nchars count=0\n'; writeFileSync(font,text); const valid=join(root,'Good.fnt');writeFileSync(valid,text.replace('pages/Page.png','Page.png'));writeFileSync(join(root,'Page.png'),png);
            const calls: string[]=[]; const runtime=new RuntimeFacade(version,{allowMemoryPanelWindowProviderFallback:true}); const router=new EditorMcpActionRouter({version:runtime.version,designSources:[],native:{},projectRead:{getProjectPath:async()=>root,getProjectName:async()=>'FNTFixture'},message:{request:async <TData=unknown,>(_target:string,name:string):Promise<TData>=>{calls.push(name);throw new Error('refusal must precede native');},send:async()=>{},broadcast:async()=>{}}});
            const before=readdirSync(root).sort();
            try {
                await assert.rejects(router.execute({operation:operation==='mixed'?'asset.import':operation,input:{sources:operation==='mixed'?[valid,font]:[font],target:'db://assets/Fonts',allowMissingDependencies:false}}), (e:unknown)=>{assert.equal(e instanceof Error&&Reflect.get(e,'isMcpControlFlowRefusal'),true); assert(e instanceof Error&&e.message.startsWith('asset_import_fnt_'));return true;});
                assert.deepEqual(calls,[]);assert.deepEqual(readdirSync(root).sort(),before);assert(!existsSync(join(root,'assets/Fonts')));assert.equal(readFileSync(font,'utf8'),text);assert.equal(readFileSync(join(root,'temp/logs/project.log'),'utf8'),'');
            } finally {runtime.execution.dispose();rmSync(root,{recursive:true,force:true});}
        });
    }
}
