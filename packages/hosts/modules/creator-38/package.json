{
    "package_version": 2,
    "name": "peanut-pod-lite-host",
    "version": "0.2.0",
    "private": true,
    "main": "./dist/main.js",
    "description": "Native Cocos Creator host for the open Peanut Pod Lite package.",
    "editor": ">=3.8.0 <3.9.0",
    "scripts": {
        "build": "tsx scripts/pack-host.mjs",
        "typecheck": "node ../../../../tools/check-javascript-syntax.mjs src panel scripts",
        "pack": "tsx scripts/pack-host.mjs",
        "test": "npm run pack && node --test tests/release-package.test.mjs tests/package-integrity.test.mts tests/cpm-install-alignment.test.mts tests/optional-pro-host.test.mjs tests/account-upgrade.test.mjs tests/managed-task-bridge.test.mts tests/managed-task-live-script.test.mts tests/throughput-soak-live-script.test.mts"
    },
    "devDependencies": {
        "esbuild": "^0.25.9"
    },
    "panels": {
        "plugin-manager": {
            "title": "Peanut Plugin Manager",
            "type": "dockable",
            "main": "panel/plugin-manager/index.js",
            "size": {
                "width": 960,
                "height": 640,
                "min-width": 720,
                "min-height": 480
            }
        },
        "plugin-manager-settings": {
            "title": "Peanut Plugin Manager Settings",
            "type": "dockable",
            "main": "panel/plugin-manager-settings/index.js",
            "size": {
                "width": 560,
                "height": 520,
                "min-width": 440,
                "min-height": 400
            }
        },
        "account": {
            "title": "Peanut Account",
            "type": "dockable",
            "main": "panel/account/index.js",
            "size": {
                "width": 440,
                "height": 640,
                "min-width": 360,
                "min-height": 480
            }
        }
    },
    "contributions": {
        "scene": {
            "script": "./dist/scene.js"
        },
        "menu": [
            {
                "path": "Extension",
                "label": "Cocos Plugin Manager",
                "message": "open-panel"
            },
            {
                "path": "Extension",
                "label": "Peanut Pod Lite Status",
                "message": "query-status"
            },
            {
                "path": "Extension",
                "label": "Peanut Account",
                "message": "open-account"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "open-plugin-manager": {
                "methods": [
                    "openPluginManagerPanel"
                ]
            },
            "open-plugin-manager-settings": {
                "methods": [
                    "openPluginManagerSettingsPanel"
                ]
            },
            "request-panel-bridge": {
                "methods": [
                    "requestPanelBridge"
                ]
            },
            "post-panel-bridge": {
                "methods": [
                    "postPanelBridge"
                ]
            },
            "get-current-locale": {
                "methods": [
                    "getCurrentLocale"
                ]
            },
            "query-status": {
                "methods": [
                    "queryStatus"
                ]
            },
            "list-tools": {
                "methods": [
                    "listTools"
                ]
            },
            "invoke-tool": {
                "methods": [
                    "invokeTool"
                ]
            },
            "query-task-status": {
                "methods": [
                    "queryTaskStatus"
                ]
            },
            "cancel-task": {
                "methods": [
                    "cancelTask"
                ]
            },
            "query-task-evidence": {
                "methods": [
                    "queryTaskEvidence"
                ]
            },
            "query-premium-offer": {
                "methods": [
                    "queryPremiumOffer"
                ]
            },
            "set-pod-endpoint": {
                "methods": [
                    "setPodEndpoint"
                ]
            },
            "set-access-token": {
                "methods": [
                    "setAccessToken"
                ]
            },
            "clear-account": {
                "methods": [
                    "clearAccount"
                ]
            },
            "query-subscription": {
                "methods": [
                    "querySubscription"
                ]
            },
            "start-checkout": {
                "methods": [
                    "startCheckout"
                ]
            },
            "refresh-pro": {
                "methods": [
                    "refreshPro"
                ]
            },
            "open-account": {
                "methods": [
                    "openAccount"
                ]
            },
            "issue-approval-lease": {
                "methods": [
                    "issueApprovalLease"
                ]
            }
        }
    },
    "peanut": {
        "role": "host",
        "verify": true,
        "profileId": "creator-38",
        "internalDependencies": []
    }
}
